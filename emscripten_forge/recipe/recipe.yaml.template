# keep in sync with
# https://github.com/emscripten-forge/recipes/tree/emscripten-6x/recipes/recipes_wasm/pyb2d3
# (only the source differs: the local checkout instead of the release tarball)
context:
  version: 0.11.1
  name: pyb2d3

source:
  path: PATH_PLACEHOLDER_TO_BE_REPLACED

build:
  number: 0

outputs:
- package:
    name: pyb2d3
    version: ${{ version }}

  build:
    script: build_pkg.sh
    files:
      exclude:
      - '**/__pycache__/**'
      - '**/*.pyc'
    python:
      skip_pyc_compilation:
      - '**/*.py'

  requirements:
    build:
    - ${{ compiler("cxx") }}
    - cross-python_${{ target_platform }}
    - cmake >=4.0
    - ninja
    - numpy
    - nanobind <2.10.2
    - scikit-build-core
    - python
    - pip
    host:
    - python-dev
    - numpy
    - box2d-static >=3.2.0
    run:
    - numpy
    - python

  tests:
  - script: pytester
    files:
      recipe:
      - test_pyb2d3.py
    requirements:
      build:
      - pytester
      run:
      - pytester-run
  - script: generic-testing
    requirements:
      build:
      - generic-testing

about:
  license: MIT
  license_file: LICENSE
  summary: python bindings for box2d v3, a 2D physics engine
  homepage: https://github.com/DerThorsten/pyb2d3

extra:
  recipe-maintainers:
  - DerThorsten
